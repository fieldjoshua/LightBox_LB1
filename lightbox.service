[Unit]
Description=LightBox Runner
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=joshuafield
WorkingDirectory=/home/joshuafield/LightBox2.0
Environment=PYTHONPATH=/home/joshuafield/LightBox2.0
Environment=PATH=/home/joshuafield/LightBox2.0/venv/bin:/usr/bin:/bin
ExecStartPre=-/usr/bin/pkill -f /home/joshuafield/LightBox2.0/run_hw.py
ExecStartPre=-/usr/bin/fuser -k 8888/tcp
ExecStartPre=-/usr/bin/fuser -k 8899/tcp
ExecStart=/home/joshuafield/LightBox2.0/venv/bin/python3 /home/joshuafield/LightBox2.0/run_hw.py
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=10
MemoryMax=300M
TasksMax=100
StandardOutput=journal
StandardError=journal
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE
LimitRTPRIO=99

[Install]
WantedBy=multi-user.target

